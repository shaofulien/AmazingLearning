# Anthropic API key — AI 單字整理與 AI 小幫手需要
# 到 https://platform.claude.com/ 取得後，複製這個檔案為 .env.local 並填入
ANTHROPIC_API_KEY=sk-ant-...

# （選填）共同編輯 WebSocket 伺服器位置
# 預設會連到 ws://<目前網域>:1234；部署到雲端時改成你的 wss:// 位址
# NEXT_PUBLIC_COLLAB_WS_URL=wss://your-collab-server.example.com

# （選填）共同編輯伺服器的 port，預設 1234
# COLLAB_PORT=1234
